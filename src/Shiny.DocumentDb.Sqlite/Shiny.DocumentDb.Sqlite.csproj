<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>$(BaseTargetFramework)</TargetFramework>
        <Description>SQLite provider for Shiny.DocumentDb</Description>
        <PackageTags>sqlite;documentdb;json;nosql;shiny</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Data.Sqlite" />

        <!-- Microsoft.Data.Sqlite still drags in the 2.1.x bundle, whose native SQLitePCLRaw.lib.e_sqlite3
             is flagged by NU1903 (GHSA-2m69-gcr7-jv3q). Referencing the 3.x bundle directly lifts the
             whole SQLitePCLRaw graph onto a patched SQLite build. -->
        <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Shiny.DocumentDb\Shiny.DocumentDb.csproj" />
    </ItemGroup>
</Project>
