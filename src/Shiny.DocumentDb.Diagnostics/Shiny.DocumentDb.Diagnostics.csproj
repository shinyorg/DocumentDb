<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>$(BaseTargetFramework)</TargetFramework>
        <Description>OpenTelemetry-native metrics and distributed tracing for Shiny.DocumentDb — a drop-in instrumentation decorator over any IDocumentStore provider, built on System.Diagnostics.Metrics and ActivitySource.</Description>
        <PackageTags>$(PackageTags) opentelemetry telemetry metrics tracing diagnostics observability</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Shiny.DocumentDb\Shiny.DocumentDb.csproj"/>
        <PackageReference Include="Microsoft.Extensions.Diagnostics"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
    </ItemGroup>

</Project>
