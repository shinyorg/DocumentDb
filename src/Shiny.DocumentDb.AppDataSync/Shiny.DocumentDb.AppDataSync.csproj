<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>$(BaseTargetFramework)</TargetFramework>
        <Description>Offline-first Shiny.Data.Sync integration for Shiny.DocumentDb — auto-enqueues local writes to the sync outbox and applies pulled server changes back into the document store.</Description>
        <PackageTags>documentdb;json;nosql;shiny;sync;offline;offline-first</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Shiny.Data.Sync" />
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Shiny.DocumentDb\Shiny.DocumentDb.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Shiny.DocumentDb.AppDataSync.Tests" />
    </ItemGroup>
</Project>
