<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>

        <IsRoslynComponent>true</IsRoslynComponent>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <!-- RS2008: analyzer release tracking not used; RS1032: message-format style -->
        <NoWarn>$(NoWarn);RS2008;RS1032</NoWarn>

        <!-- Not published as its own NuGet package — the built DLL is bundled into the
             Shiny.DocumentDb package under analyzers/dotnet/cs (see that project's csproj). -->
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
        <DevelopmentDependency>true</DevelopmentDependency>
        <!-- override Directory.Build.props Release packaging that doesn't apply to an analyzer -->
        <IsPackable>false</IsPackable>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <IncludeSource>false</IncludeSource>
        <IncludeSymbols>false</IncludeSymbols>
        <NoWarn>$(NoWarn);NU5128</NoWarn>

        <!-- the AOT/trim analyzers don't apply to a netstandard2.0 build-time component -->
        <EnableAotAnalyzer>false</EnableAotAnalyzer>
        <EnableTrimAnalyzer>false</EnableTrimAnalyzer>

        <Description>Source generator for Shiny.DocumentDb strongly-typed DocumentContext / DocumentSet&lt;T&gt;.</Description>
        <PackageTags>documentdb shiny source-generator roslyn aot</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
    </ItemGroup>
</Project>
