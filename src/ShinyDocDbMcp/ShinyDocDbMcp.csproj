<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>$(BaseTargetFramework)</TargetFramework>
        <RootNamespace>ShinyDocDbMcp</RootNamespace>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <Description>An MCP (Model Context Protocol) server for Shiny.DocumentDb stores, over stdio. Point Claude Code, Claude Desktop, Copilot or any MCP client at a store and let it explore and query the data — read-only by default, with page caps and per-collection scope filters.</Description>

        <PackAsTool>true</PackAsTool>
        <ToolCommandName>shiny-documentdb-mcp</ToolCommandName>
        <PackageId>ShinyDocDbMcp</PackageId>
        <IsPackable>true</IsPackable>
        <PackageReadmeFile>readme.md</PackageReadmeFile>

        <!-- Same call as the admin tools: ADO.NET provider clients are reflection-heavy. This is an app. -->
        <IsAotCompatible>false</IsAotCompatible>
        <EnableAotAnalyzer>false</EnableAotAnalyzer>
        <EnableTrimAnalyzer>false</EnableTrimAnalyzer>

        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <IncludeSource>false</IncludeSource>

        <!-- Inherited transitively from Admin Core - see the note on its SQLitePCLRaw item group. -->
        <NoWarn>$(NoWarn);NU1903</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <!--
          The connection story is the admin tool's, verbatim: the same profile store, the same
          SecretProtector, the same provider catalog. No new secret handling in this package.
        -->
        <ProjectReference Include="..\ShinyDocDbMyAdmin.Core\ShinyDocDbMyAdmin.Core.csproj"/>
        <ProjectReference Include="..\Shiny.DocumentDb.Mcp\Shiny.DocumentDb.Mcp.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting"/>
        <PackageReference Include="Microsoft.Extensions.Configuration"/>
        <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables"/>
    </ItemGroup>

    <ItemGroup>
        <None Remove="..\..\readme.md"/>
        <None Include="readme.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

</Project>
