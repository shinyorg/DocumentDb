<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>$(BaseTargetFramework)</TargetFramework>
        <Description>Database-agnostic document store with JSON querying for .NET</Description>
        <PackageTags>documentdb;json;nosql;shiny</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Shiny.DocumentDb.LiteDb" />
        <InternalsVisibleTo Include="Shiny.DocumentDb.CosmosDb" />
        <InternalsVisibleTo Include="Shiny.DocumentDb.AzureTable" />
        <InternalsVisibleTo Include="Shiny.DocumentDb.DynamoDb" />
        <InternalsVisibleTo Include="Shiny.DocumentDb.IndexedDb" />
        <InternalsVisibleTo Include="Shiny.DocumentDb.MongoDb" />
        <InternalsVisibleTo Include="Shiny.DocumentDb.Diagnostics" />
        <InternalsVisibleTo Include="Shiny.DocumentDb.Tests" />
    </ItemGroup>

    <!-- The typed-context source generator is bundled into this package (analyzers/dotnet/cs),
         so consumers get DocumentContext/DocumentSet<T> generation with no second package. -->
    <ItemGroup>
        <ProjectReference Include="..\Shiny.DocumentDb.Generators\Shiny.DocumentDb.Generators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"
                          PrivateAssets="all" />
    </ItemGroup>

    <PropertyGroup>
        <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_PackTypedContextGenerator</TargetsForTfmSpecificContentInPackage>
    </PropertyGroup>
    <Target Name="_PackTypedContextGenerator" DependsOnTargets="ResolveProjectReferences">
        <ItemGroup>
            <TfmSpecificPackageFile Include="@(Analyzer)"
                                    Condition="'%(Analyzer.Filename)' == 'Shiny.DocumentDb.Generators'"
                                    PackagePath="analyzers/dotnet/cs" />
        </ItemGroup>
    </Target>

</Project>
