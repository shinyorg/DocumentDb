<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>$(BaseTargetFramework)</TargetFramework>
        <Description>Database-agnostic document store with JSON querying for .NET, with built-in dependency-injection registration and OpenTelemetry instrumentation.</Description>
        <PackageTags>documentdb;json;nosql;shiny;dependencyinjection;opentelemetry;diagnostics</PackageTags>
    </PropertyGroup>

    <!-- DI registration (AddDocumentStore / AddDocumentContext / seeding) and OpenTelemetry instrumentation now
         ship in the core package. DependencyInjection.Abstractions gives IServiceCollection + IServiceScopeFactory;
         Hosting.Abstractions backs the seeder IHostedService; Extensions.Diagnostics (+ transitive DiagnosticSource)
         backs the metrics/tracing decorator. All AOT/trim-safe. -->
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
        <PackageReference Include="Microsoft.Extensions.Diagnostics" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Shiny.DocumentDb.LiteDb" />
        <InternalsVisibleTo Include="Shiny.DocumentDb.CosmosDb" />
        <InternalsVisibleTo Include="Shiny.DocumentDb.AzureTable" />
        <InternalsVisibleTo Include="Shiny.DocumentDb.DynamoDb" />
        <InternalsVisibleTo Include="Shiny.DocumentDb.IndexedDb" />
        <InternalsVisibleTo Include="Shiny.DocumentDb.MongoDb" />
        <InternalsVisibleTo Include="Shiny.DocumentDb.Firestore" />
        <!-- The mobile Firestore provider lives in the sibling ~/Desktop/dev/firebase repo. -->
        <InternalsVisibleTo Include="Shiny.DocumentDb.Firestore.Mobile" />
        <InternalsVisibleTo Include="Shiny.DocumentDb.Redis" />
        <InternalsVisibleTo Include="Shiny.DocumentDb.RavenDb" />
        <InternalsVisibleTo Include="Shiny.DocumentDb.Tests" />
    </ItemGroup>

    <!-- The typed-context source generator is bundled into this package (analyzers/dotnet/cs),
         so consumers get DocumentContext/DocumentSet<T> generation with no second package. -->
    <ItemGroup>
        <ProjectReference Include="..\Shiny.DocumentDb.Generators\Shiny.DocumentDb.Generators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"
                          PrivateAssets="all" />
    </ItemGroup>

    <PropertyGroup>
        <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_PackTypedContextGenerator</TargetsForTfmSpecificContentInPackage>
    </PropertyGroup>
    <Target Name="_PackTypedContextGenerator" DependsOnTargets="ResolveProjectReferences">
        <ItemGroup>
            <TfmSpecificPackageFile Include="@(Analyzer)"
                                    Condition="'%(Analyzer.Filename)' == 'Shiny.DocumentDb.Generators'"
                                    PackagePath="analyzers/dotnet/cs" />
        </ItemGroup>
    </Target>

</Project>
