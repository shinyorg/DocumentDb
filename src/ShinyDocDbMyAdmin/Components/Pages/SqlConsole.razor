@page "/sql/{ProfileId}"
@inject ProfileStore Profiles
@inject NavigationManager Nav

<PageTitle>Query - ShinyDocDbMyAdmin</PageTitle>

<h1>Query console</h1>
<p class="muted">
    Two ways to ask @(this.descriptor?.DisplayName ?? "the connection") the same question: DocumentDb's
    string query grammar, or the database's own SQL.
</p>

<div class="tabs">
    <a href="@($"/db/{Uri.EscapeDataString(this.ProfileId)}")">Tables</a>
    <a class="active" href="@($"/sql/{Uri.EscapeDataString(this.ProfileId)}")">Query</a>
</div>

<div class="tabs sub">
    <button class="@(this.mode == Mode.Filter ? "active" : "")" type="button"
            @onclick="() => this.mode = Mode.Filter">Filter grammar</button>
    <button class="@(this.mode == Mode.Sql ? "active" : "")" type="button"
            @onclick="() => this.mode = Mode.Sql">Raw SQL</button>
</div>

@*
    Both panels stay alive across a mode switch — each holds its own editor contents, results and
    history, and losing them because you glanced at the other tab would be its own small betrayal.
*@
<div hidden="@(this.mode != Mode.Filter)">
    <FilterQueryPanel ProfileId="@this.ProfileId" OnOpenInSql="this.OpenInSql" />
</div>

<div hidden="@(this.mode != Mode.Sql)">
    <SqlQueryPanel ProfileId="@this.ProfileId" Descriptor="@this.descriptor"
                   ReadOnly="@this.readOnly" InitialSql="@this.handoffSql" />
</div>

@code {
    [Parameter] public string ProfileId { get; set; } = "";

    enum Mode { Filter, Sql }

    Mode mode = Mode.Filter;
    ProviderDescriptor? descriptor;
    bool readOnly;

    /// <summary>SQL sent over from the filter console, so a grammar query is a starting point.</summary>
    string? handoffSql;

    protected override async Task OnParametersSetAsync()
    {
        var profile = await this.Profiles.Get(this.ProfileId);
        if (profile is null)
        {
            this.Nav.NavigateTo("/");
            return;
        }

        this.descriptor = ProviderCatalog.Get(profile.Provider);
        this.readOnly = profile.ReadOnly;
    }

    void OpenInSql(string sql)
    {
        this.handoffSql = sql;
        this.mode = Mode.Sql;
    }
}
