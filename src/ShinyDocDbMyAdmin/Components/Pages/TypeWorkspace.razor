@page "/db/{ProfileId}/{Table}/{TypeName}"
@inject DocumentAdminService Admin
@inject ProfileStore Profiles
@inject AiAvailability Availability

<PageTitle>@this.TypeName - ShinyDocDbMyAdmin</PageTitle>

@*
    ws-head / ws-body turn the workspace into an app shell: the type name and its tabs hold still while
    only the panel between them scrolls, so switching tabs never means scrolling back up to find them.
    The workspace picks this up with :has(> .ws-head) — no flag to thread through the layout, and any
    page that wants the same behaviour gets it by using the same two elements.
*@
<div class="ws-head">
    <h1>@this.TypeName</h1>
    <p class="muted">in <a href="@this.TableHref">@this.Table</a></p>

    <div class="tabs">
    <a class="@(this.Tab == "browse" ? "active" : "")" href="@this.Href("browse")">Browse</a>
    <a class="@(this.Tab == "structure" ? "active" : "")" href="@this.Href("structure")">Structure</a>
    @if (this.hasHistory)
    {
        <a class="@(this.Tab == "history" ? "active" : "")" href="@this.Href("history")">History</a>
    }
    @if (this.hasGeometry)
    {
        <a class="@(this.Tab == "geometry" ? "active" : "")" href="@this.Href("geometry")">Geometry</a>
    }
    @if (this.hasFullText)
    {
        <a class="@(this.Tab == "fulltext" ? "active" : "")" href="@this.Href("fulltext")">Full text</a>
    }
    @if (this.hasVectors)
    {
        <a class="@(this.Tab == "vectors" ? "active" : "")" href="@this.Href("vectors")">Vectors</a>
    }
    @if (this.hasBlobs)
    {
        <a class="@(this.Tab == "blobs" ? "active" : "")" href="@this.Href("blobs")">Blobs</a>
    }
        <a class="@(this.Tab == "transfer" ? "active" : "")" href="@this.Href("transfer")">Import / Export</a>
    @if (this.hasAssistant)
    {
        <a class="@(this.Tab == "assistant" ? "active" : "")" href="@this.Href("assistant")">Assistant</a>
    }
        <a href="@($"/sql/{Uri.EscapeDataString(this.ProfileId)}")">SQL</a>
    </div>
</div>

<div class="ws-body">
@switch (this.Tab)
{
    case "structure":
        <StructureTab ProfileId="@this.ProfileId" Table="@this.Table" TypeName="@this.TypeName" />
        break;

    case "history":
        <TemporalTab ProfileId="@this.ProfileId" Table="@this.Table" TypeName="@this.TypeName" Document="@this.Document" />
        break;

    case "geometry":
        <GeometryTab ProfileId="@this.ProfileId" Table="@this.Table" TypeName="@this.TypeName" Document="@this.Document" />
        break;

    case "fulltext":
        <FullTextTab ProfileId="@this.ProfileId" Table="@this.Table" TypeName="@this.TypeName" />
        break;

    case "vectors":
        <VectorsTab ProfileId="@this.ProfileId" Table="@this.Table" TypeName="@this.TypeName" />
        break;

    case "blobs":
        <BlobsTab ProfileId="@this.ProfileId" Table="@this.Table" TypeName="@this.TypeName" Document="@this.Document" />
        break;

    case "transfer":
        <TransferTab ProfileId="@this.ProfileId" Table="@this.Table" TypeName="@this.TypeName" />
        break;

    case "assistant" when this.hasAssistant:
        <AssistantPanel ProfileId="@this.ProfileId" Table="@this.Table" TypeName="@this.TypeName" />
        break;

    default:
        <BrowseTab ProfileId="@this.ProfileId" Table="@this.Table" TypeName="@this.TypeName"
                   HasHistory="@this.hasHistory" HasBlobs="@this.hasBlobs" HasGeometry="@this.hasGeometry" />
        break;
}
</div>

@code {
    [Parameter] public string ProfileId { get; set; } = "";
    [Parameter] public string Table { get; set; } = "";
    [Parameter] public string TypeName { get; set; } = "";

    [SupplyParameterFromQuery(Name = "tab")]
    public string? Tab { get; set; }

    /// <summary>
    /// Narrows a sidecar tab to one document, as the History / Blobs / Geometry links on a browse row
    /// build. The sidecars are all keyed by document id, so the same query string works for each of them.
    /// </summary>
    [SupplyParameterFromQuery(Name = "doc")]
    public string? Document { get; set; }

    bool hasBlobs;
    bool hasGeometry;
    bool hasHistory;
    bool hasVectors;
    bool hasFullText;
    bool hasAssistant;
    string probedKey = "";

    string TableHref => $"/db/{Uri.EscapeDataString(this.ProfileId)}/{Uri.EscapeDataString(this.Table)}";

    string Href(string tab)
        => $"{this.TableHref}/{Uri.EscapeDataString(this.TypeName)}?tab={tab}";

    protected override async Task OnParametersSetAsync()
    {
        // The Geometry and Blobs tabs only appear when there is something behind them, so a type with
        // neither is not cluttered with two dead ends. Probed once per type, not per tab switch.
        var key = $"{this.ProfileId}|{this.Table}|{this.TypeName}";
        if (key == this.probedKey)
            return;

        this.probedKey = key;
        this.hasBlobs = false;
        this.hasGeometry = false;
        this.hasHistory = false;
        this.hasVectors = false;
        this.hasFullText = false;
        this.hasAssistant = false;

        // Two conditions, both cheap: the deployment allows an assistant at all, and this connection
        // has one configured and switched on. No probe of the database is involved.
        if (this.Availability.IsEnabled)
        {
            try
            {
                this.hasAssistant = (await this.Profiles.GetAiSettings(this.ProfileId))?.IsUsable() ?? false;
            }
            catch (Exception)
            {
                // Same as the sidecar probes below: no tab rather than an error page.
            }
        }

        try
        {
            this.hasBlobs = await this.Admin.HasBlobSidecar(this.ProfileId, this.Table);
        }
        catch (Exception)
        {
            // A probe failure is not worth blocking the workspace; the tab just stays hidden.
        }

        try
        {
            this.hasHistory = await this.Admin.HasHistorySidecar(this.ProfileId, this.Table);
        }
        catch (Exception)
        {
            // Same: no History tab rather than an error page.
        }

        try
        {
            this.hasGeometry = (await this.Admin.FindGeometryPaths(this.ProfileId, this.Table, this.TypeName)).Count > 0;
        }
        catch (Exception)
        {
            // Same: no geometry tab rather than an error page.
        }

        try
        {
            this.hasVectors = await this.Admin.HasVectors(this.ProfileId, this.Table, this.TypeName);
        }
        catch (Exception)
        {
            // Same: no Vectors tab rather than an error page.
        }

        try
        {
            // Shown only when this type is actually indexed - a backend that merely *could* do full
            // text is not a reason to offer a search box that would find nothing.
            this.hasFullText = (await this.Admin.DescribeFullTextIndex(this.ProfileId, this.Table, this.TypeName)).Present;
        }
        catch (Exception)
        {
            // Same: no Full text tab rather than an error page.
        }
    }
}
