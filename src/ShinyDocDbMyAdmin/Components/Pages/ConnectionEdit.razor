@page "/connections/new"
@page "/connections/{Id}"
@inject ProfileStore Profiles
@inject DocumentAdminService Admin
@inject ConnectionManager Connections
@inject DatabaseUploadService Uploads
@inject UiEvents Events
@inject DemoMode Demo
@inject NavigationManager Nav

@if (!this.Demo.CanManageConnections)
{
    @* Unlinked everywhere, but a deep link still lands here - so here refuses. *@
    <div class="empty">
        <h2>Connections are fixed on this instance</h2>
        <p>This is a demo instance: it publishes one read-only connection and cannot be pointed anywhere else.</p>
        <a class="btn primary" href="/">Back to connections</a>
    </div>
}
else
{

<PageTitle>@(this.isNew ? "New connection" : this.profile.Name) - ShinyDocDbMyAdmin</PageTitle>

<h1>@(this.isNew ? "New connection" : $"Edit '{this.profile.Name}'")</h1>

@if (this.message is not null)
{
    <div class="note @this.messageClass">@this.message</div>
}

<div class="panel" style="max-width: 720px">
    <div class="body">
        <label class="field">
            <span class="lbl">Name</span>
            <input type="text" @bind="this.profile.Name" @bind:event="oninput" placeholder="Local orders database" />
        </label>

        <label class="field">
            <span class="lbl">Provider</span>
            <select value="@this.profile.Provider" @onchange="this.OnProviderChanged">
                @foreach (var descriptor in ProviderCatalog.Descriptors)
                {
                    <option value="@descriptor.Kind">@descriptor.DisplayName</option>
                }
            </select>
        </label>

        @if (this.Descriptor.IsFileBased)
        {
            <label class="field">
                <span class="lbl">Upload a database file</span>
                <InputFile OnChange="this.OnFileSelected" accept="@string.Join(",", this.Descriptor.FileExtensions)" />
                <span class="hint">
                    Copied into the tool's data directory and owned by this connection - removing the
                    connection deletes it. Up to @DatabaseUploadService.Humanize(DatabaseUploadService.MaxUploadBytes).
                    Leave empty to point at a file already on this machine.
                </span>
            </label>

            @if (this.uploaded is not null)
            {
                <div class="note ok">Uploaded @this.uploaded.FileName (@DatabaseUploadService.Humanize(this.uploaded.Bytes)).</div>
            }
        }

        <label class="field">
            <span class="lbl">@(this.Descriptor.IsFileBased ? "File path" : "Connection string")</span>
            <input type="text" class="mono" @bind="this.connectionString" @bind:event="oninput" placeholder="@this.Descriptor.Placeholder" />
            @if (!this.Descriptor.IsFileBased)
            {
                <span class="hint">Stored encrypted (@this.KeyNote).</span>
            }
        </label>

        @if (this.Descriptor.RequiresPassword)
        {
            <label class="field">
                <span class="lbl">Encryption key</span>
                <input type="password" @bind="this.password" @bind:event="oninput" placeholder="SQLCipher password" />
                <span class="hint">Required - SQLCipher cannot open the file without it.</span>
            </label>
        }

        <label class="check field">
            <input type="checkbox" @bind="this.profile.ReadOnly" />
            <span>Read-only (block every write, and refuse non-SELECT statements in the SQL console)</span>
        </label>

        <label class="check field">
            <input type="checkbox" @bind="this.profile.HideForeignTables" />
            <span>Collapse tables that are not DocumentDb's on the overview</span>
        </label>

        <div class="field">
            <span class="lbl">Soft-deleted types (optional)</span>
            <span class="hint">
                <code>AddSoftDelete</code> writes no column, table or index — it is an interceptor and a query
                filter inside your application — so <strong>this tool cannot discover it</strong>. Until a type
                is declared here, deleting one of its documents from this tool is a permanent delete, and the
                application would only have flagged it. Declare a type and the delete button flags instead,
                Browse gains a live / deleted / all filter, and flagged documents are badged. The Structure tab
                suggests candidates it recognises.
            </span>

            @foreach (var flag in this.softDeleteFlags)
            {
                <div class="toolbar" style="margin-top: 6px">
                    <input type="text" class="mono w-sm" placeholder="TypeName"
                           @bind="flag.TypeName" @bind:event="oninput" />
                    <input type="text" class="mono grow" placeholder="isDeleted"
                           @bind="flag.PropertyPath" @bind:event="oninput" />
                    <select class="w-sm" @bind="flag.FlagKind">
                        <option value="@SoftDeleteFlagKind.Boolean">bool</option>
                        <option value="@SoftDeleteFlagKind.Timestamp">timestamp</option>
                    </select>
                    <button class="btn ghost sm" type="button" @onclick="() => this.softDeleteFlags.Remove(flag)">Remove</button>
                </div>
            }

            <div class="toolbar" style="margin-top: 6px">
                <button class="btn ghost sm" type="button" @onclick="() => this.softDeleteFlags.Add(new SoftDeleteFlag())">
                    Declare a type
                </button>
                <span class="faint">
                    The stored <span class="mono">TypeName</span>, and the JSON path of the flag —
                    <span class="mono">bool</span> restores to <span class="mono">false</span>,
                    <span class="mono">timestamp</span> to <span class="mono">null</span>.
                </span>
            </div>
        </div>

        <div class="field">
            <span class="lbl">🔒 Field-level encryption keys (optional)</span>
            <span class="hint">
                These keys let this tool <strong>read</strong> protected values. They are stored beside the
                connection string and are only as safe as this installation. Leave empty and everything else
                still works — encrypted fields are recognised, counted and protected from being overwritten
                with no key at all. The tool never writes an envelope, never decrypts into an export, and
                never sends a decrypted value to the AI assistant.
            </span>

            @foreach (var entry in this.encryptionKeys)
            {
                <div class="toolbar" style="margin-top: 6px">
                    <input type="text" class="mono w-sm" placeholder="key id (k1)"
                           @bind="entry.KeyId" @bind:event="oninput" />
                    <input type="password" class="mono grow" placeholder="base64 AES-256 key"
                           @bind="entry.Key" @bind:event="oninput" />
                    <button class="btn ghost sm" type="button" @onclick="() => this.encryptionKeys.Remove(entry)">Remove</button>
                </div>
            }

            <div class="toolbar" style="margin-top: 6px">
                <button class="btn ghost sm" type="button" @onclick="() => this.encryptionKeys.Add(new EncryptionKeyEntry())">
                    Add a key
                </button>
                <span class="faint">The id is the one in the envelope — the <span class="mono">k1</span> in <span class="mono">enc:1:k1:…</span>.</span>
            </div>
        </div>

        <div class="toolbar">
            <button class="btn primary" type="button" disabled="@this.busy" @onclick="this.Save">Save</button>
            <button class="btn" type="button" disabled="@this.busy" @onclick="this.SaveAndTest">Save and test</button>
            <a class="btn ghost" href="/">Cancel</a>
        </div>
    </div>
</div>

}

@code {
    [Parameter] public string? Id { get; set; }

    ConnectionProfile profile = new();
    string connectionString = "";
    string password = "";
    List<EncryptionKeyEntry> encryptionKeys = [];
    List<SoftDeleteFlag> softDeleteFlags = [];
    UploadResult? uploaded;
    string? message;
    string messageClass = "";
    bool busy;
    bool isNew = true;

    ProviderDescriptor Descriptor => ProviderCatalog.Get(this.profile.Provider);

    string KeyNote => "set ShinyDocDbMyAdmin:SecretKey to control the key";

    protected override async Task OnParametersSetAsync()
    {
        this.isNew = string.IsNullOrEmpty(this.Id);
        if (this.isNew)
        {
            this.profile = new ConnectionProfile();
            this.connectionString = this.Descriptor.ConnectionStringTemplate;
            this.encryptionKeys = [];
            this.softDeleteFlags = [];
            return;
        }

        // A host-provided connection has no editable form: it is declared in the AppHost, not here.
        var existing = this.Profiles.IsProvided(this.Id!) ? null : await this.Profiles.Get(this.Id!);
        if (existing is null)
        {
            this.Nav.NavigateTo("/");
            return;
        }

        this.profile = existing;
        this.connectionString = this.Profiles.RevealConnectionString(existing);
        this.password = this.Profiles.RevealPassword(existing) ?? "";
        this.encryptionKeys = [.. this.Profiles.RevealEncryptionKeys(existing)];

        // Copied for the same reason as the keys: the form edits its own list, and Save replaces the
        // profile's with what survived validation.
        this.softDeleteFlags =
        [
            .. existing.SoftDeleteFlags.Select(f => new SoftDeleteFlag
            {
                TypeName = f.TypeName, PropertyPath = f.PropertyPath, FlagKind = f.FlagKind
            })
        ];
    }

    void OnProviderChanged(ChangeEventArgs e)
    {
        if (!Enum.TryParse<ProviderKind>(e.Value?.ToString(), out var kind))
            return;

        var wasTemplate = this.connectionString == this.Descriptor.ConnectionStringTemplate;
        this.profile.Provider = kind;

        // Only replace the connection string if the user has not typed their own.
        if (wasTemplate || string.IsNullOrWhiteSpace(this.connectionString))
            this.connectionString = this.Descriptor.ConnectionStringTemplate;
    }

    async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        this.busy = true;
        this.message = null;
        try
        {
            this.uploaded = await this.Uploads.Save(this.profile.Id, this.profile.Provider, e.File);
            this.profile.UploadedFileName = this.uploaded.FileName;
            this.connectionString = $"Data Source={this.uploaded.FullPath}";
            if (string.IsNullOrWhiteSpace(this.profile.Name))
                this.profile.Name = Path.GetFileNameWithoutExtension(this.uploaded.FileName);

            this.messageClass = "ok";
        }
        catch (Exception ex)
        {
            this.message = ex.Message;
            this.messageClass = "err";
        }
        finally
        {
            this.busy = false;
        }
    }

    async Task<bool> Persist()
    {
        if (string.IsNullOrWhiteSpace(this.profile.Name))
        {
            this.message = "Give the connection a name.";
            this.messageClass = "err";
            return false;
        }

        if (string.IsNullOrWhiteSpace(this.connectionString))
        {
            this.message = this.Descriptor.IsFileBased ? "Upload a file or enter a path." : "Enter a connection string.";
            this.messageClass = "err";
            return false;
        }

        if (this.Descriptor.RequiresPassword && string.IsNullOrEmpty(this.password))
        {
            this.message = "SQLCipher connections need an encryption key.";
            this.messageClass = "err";
            return false;
        }

        // Bound to the form's own list rather than edited in place on the profile: Save replaces the
        // list with wrapped copies, and re-editing a wrapped value would double-wrap it.
        this.profile.EncryptionKeys = this.encryptionKeys;
        this.profile.SoftDeleteFlags =
        [
            .. this.softDeleteFlags
                .Where(f => !string.IsNullOrWhiteSpace(f.TypeName) && !string.IsNullOrWhiteSpace(f.PropertyPath))
                .Select(f => new SoftDeleteFlag
                {
                    TypeName = f.TypeName.Trim(), PropertyPath = f.PropertyPath.Trim(), FlagKind = f.FlagKind
                })
        ];

        await this.Profiles.Save(this.profile, this.connectionString.Trim(), this.password);

        // The provider instance is built from these values, so any cached one is now wrong.
        this.Connections.Evict(this.profile.Id);
        this.Admin.InvalidateSchema(this.profile.Id);
        await this.Events.NotifyProfilesChanged();
        return true;
    }

    async Task Save()
    {
        this.busy = true;
        try
        {
            if (await this.Persist())
                this.Nav.NavigateTo($"/db/{Uri.EscapeDataString(this.profile.Id)}");
        }
        catch (Exception ex)
        {
            this.message = ex.Message;
            this.messageClass = "err";
        }
        finally
        {
            this.busy = false;
        }
    }

    async Task SaveAndTest()
    {
        this.busy = true;
        try
        {
            if (!await this.Persist())
                return;

            this.message = await this.Admin.TestConnection(this.profile.Id);
            this.messageClass = "ok";
            this.isNew = false;
            this.Id = this.profile.Id;
        }
        catch (Exception ex)
        {
            this.message = ex.Message;
            this.messageClass = "err";
        }
        finally
        {
            this.busy = false;
        }
    }
}
