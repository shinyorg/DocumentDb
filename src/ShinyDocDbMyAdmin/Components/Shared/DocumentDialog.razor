@inject DocumentAdminService Admin

<div class="overlay" @onclick="this.OnBackdrop">
    <div class="dialog" @onclick:stopPropagation>
        <header>
            <span>@(this.IsNew ? "New document" : "Edit document")</span>
            <span class="badge">@this.TypeName</span>
            <span class="spacer"></span>
            <button class="btn ghost sm" type="button" @onclick="this.Close">✕</button>
        </header>

        <div class="body">
            @if (this.error is not null)
            {
                <div class="note err"><span class="mono">@this.error</span></div>
            }

            @if (this.downgrades.Count > 0)
            {
                @* The confirmation, not a warning. Saving from here writes clear text on purpose. *@
                <div class="note err">
                    <strong>@string.Join(", ", this.downgrades)</strong>
                    would be saved in clear text. The application will read
                    @(this.downgrades.Count == 1 ? "it" : "them") back as plaintext and the value is no longer
                    protected — nothing will error, and nothing else will notice.
                    <div style="margin-top: 8px">
                        <button class="btn danger sm" type="button" disabled="@this.busy" @onclick="this.SaveAnyway">
                            Save in clear text
                        </button>
                        <button class="btn ghost sm" type="button" @onclick="() => this.downgrades = []">Cancel</button>
                    </div>
                </div>
            }
            else if (this.encryptedPaths.Count > 0)
            {
                @* Before anyone starts typing, not after they have saved. *@
                <div class="note warn">
                    🔒 <strong>@string.Join(", ", this.encryptedPaths)</strong>
                    @(this.encryptedPaths.Count == 1 ? "holds a" : "hold") field-level encryption
                    @(this.encryptedPaths.Count == 1 ? "value" : "values"). Leave the
                    @* <code>, not .mono - inside a .note the latter is display:block and would break the line. *@
                    <code>enc:…</code> text exactly as it is — this tool cannot re-encrypt what you
                    overtype, and a saved plaintext value is simply no longer protected.
                </div>
            }

            <label class="field">
                <span class="lbl">Document id</span>
                <input type="text" class="mono" @bind="this.id" @bind:event="oninput" readonly="@(!this.IsNew)" />
                @if (!this.IsNew)
                {
                    <span class="hint">The id is the primary key; create a new document to change it.</span>
                }
            </label>

            <label class="field">
                <span class="lbl">Body</span>
                <textarea class="editor" spellcheck="false" @bind="this.json" @bind:event="oninput"></textarea>
                <span class="hint">
                    The id above is written into the body on save, matching how DocumentDb mirrors it.
                </span>
            </label>
        </div>

        <footer>
            <button class="btn primary" type="button" disabled="@this.busy" @onclick="this.Save">Save</button>
            <button class="btn" type="button" disabled="@this.busy" @onclick="this.Format">Format</button>
            <span class="spacer"></span>
            <span class="faint">@this.status</span>
            <button class="btn ghost" type="button" @onclick="this.Close">Cancel</button>
        </footer>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string ProfileId { get; set; } = "";
    [Parameter, EditorRequired] public string Table { get; set; } = "";
    [Parameter, EditorRequired] public string TypeName { get; set; } = "";

    /// <summary>Null opens the dialog in insert mode.</summary>
    [Parameter] public DocumentRow? Row { get; set; }

    /// <summary>
    /// Raised with what became of the type's vector sidecar, so the caller can report a document that
    /// was written but left an embedding behind.
    /// </summary>
    [Parameter] public EventCallback<VectorSyncOutcome> OnSaved { get; set; }
    [Parameter] public EventCallback OnCancelled { get; set; }

    string id = "";
    string json = "";
    string? error;
    string status = "";
    bool busy;
    IReadOnlyList<string> encryptedPaths = [];
    IReadOnlyList<string> downgrades = [];

    bool IsNew => this.Row is null;

    protected override async Task OnParametersSetAsync()
    {
        if (this.Row is { } row)
        {
            this.id = row.Id;
            this.json = DocumentAdminService.Prettify(row.Json);
            this.status = row.UpdatedAt is { } updated ? $"updated {updated.ToLocalTime():yyyy-MM-dd HH:mm:ss}" : "";
        }
        else
        {
            this.id = Guid.NewGuid().ToString();
            this.json = DocumentAdminService.NewDocumentTemplate(this.id);
            this.status = "";
        }

        this.downgrades = [];

        // Read before anyone types rather than discovered on save: a banner over an empty editor is the
        // only version of this that prevents the mistake instead of reporting it.
        try
        {
            this.encryptedPaths = await this.Admin.EncryptedPathsFor(this.ProfileId, this.Table, this.TypeName);
        }
        catch (Exception)
        {
            // The banner is advice. A type that cannot be sampled still opens - the save-time guard is
            // the one that has to be right, and it runs against the stored document either way.
            this.encryptedPaths = [];
        }
    }

    void Format()
    {
        this.error = null;
        try
        {
            this.json = DocumentAdminService.Prettify(DocumentAdminService.Minify(this.json));
        }
        catch (Exception ex)
        {
            this.error = ex.Message;
        }
    }

    Task Save() => this.Write(allowDowngrade: false);

    Task SaveAnyway() => this.Write(allowDowngrade: true);

    async Task Write(bool allowDowngrade)
    {
        this.busy = true;
        this.error = null;
        try
        {
            var outcome = await this.Admin.SaveDocument(
                this.ProfileId, this.Table, this.TypeName, this.id.Trim(), this.json, this.IsNew, allowDowngrade);

            await this.OnSaved.InvokeAsync(outcome);
        }
        catch (EncryptedFieldDowngradeException ex)
        {
            // Not an error to read and dismiss: the paths become a confirmation with a second button,
            // because the operator may well have meant to do exactly this.
            this.downgrades = ex.Paths;
        }
        catch (Exception ex)
        {
            this.error = ex.Message;
        }
        finally
        {
            this.busy = false;
        }
    }

    Task Close() => this.OnCancelled.InvokeAsync();

    // Clicking the backdrop is a common way to bail out, but not while a save is in flight.
    Task OnBackdrop() => this.busy ? Task.CompletedTask : this.Close();
}
