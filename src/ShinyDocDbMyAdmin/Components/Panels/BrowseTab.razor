@inject DocumentAdminService Admin
@inject ProfileStore Profiles
@inject UiEvents Events

@* fill: this panel owns the leftover height, so the rows scroll under a fixed header and pager. *@
<div class="panel fill">
    <header>
        Browse
        <span class="spacer"></span>
        <button class="btn sm" type="button" disabled="@this.busy" @onclick="() => this.Load(true)">Refresh</button>
        @if (!this.readOnly)
        {
            <button class="btn sm primary" type="button" @onclick="this.StartInsert">+ Document</button>
        }
    </header>

    <div class="body">
        <div class="toolbar">
            <input type="text" class="grow" placeholder="Search text fields…"
                   @bind="this.search" @bind:event="oninput" @onkeydown="this.OnSearchKey" />
            <button class="btn" type="button" disabled="@this.busy" @onclick="() => this.Load(false)">Search</button>
            <button class="btn ghost" type="button" @onclick="this.AddFilter">+ Filter</button>
            <button class="btn ghost" type="button" @onclick="() => this.showColumns = !this.showColumns">Columns</button>
            @if (this.softDelete is not null)
            {
                @* Only for a declared type. Nothing in the database says a type is soft-deleted, so this
                   control appears exactly when the operator has told us it is. *@
                <select class="w-sm" @bind="this.deletedFilter" @bind:after="() => this.Load(false)"
                        title="@($"'{this.TypeName}' is declared for soft delete on '{this.softDelete.PropertyPath}'")">
                    <option value="@DeletedFilter.Live">Live</option>
                    <option value="@DeletedFilter.Deleted">Deleted</option>
                    <option value="@DeletedFilter.All">All</option>
                </select>
            }
            <select class="w-sm" @bind="this.pageSize" @bind:after="() => this.Load(false)">
                @foreach (var size in new[] { 10, 25, 50, 100, 250 })
                {
                    <option value="@size">@size / page</option>
                }
            </select>
        </div>

        @if (this.filters.Count > 0)
        {
            <div class="stack" style="margin-top: 8px">
                @for (var i = 0; i < this.filters.Count; i++)
                {
                    var index = i;
                    var filter = this.filters[index];
                    <div class="toolbar">
                        <select class="w-md" value="@filter.Path" @onchange="e => this.UpdateFilter(index, path: e.Value?.ToString())">
                            <option value="">— field —</option>
                            @foreach (var path in this.AllPaths)
                            {
                                <option value="@path">@path</option>
                            }
                        </select>
                        <select class="w-sm" value="@filter.Operator" @onchange="e => this.UpdateFilter(index, op: e.Value?.ToString())">
                            @foreach (var op in Enum.GetValues<FilterOperator>())
                            {
                                <option value="@op">@Label(op)</option>
                            }
                        </select>
                        @if (filter.Operator is not (FilterOperator.IsNull or FilterOperator.IsNotNull))
                        {
                            <input type="text" class="grow mono" placeholder="value" value="@filter.Value"
                                   @onchange="e => this.UpdateFilter(index, value: e.Value?.ToString())" />
                        }
                        else
                        {
                            <span class="grow"></span>
                        }
                        <button class="btn ghost sm" type="button" @onclick="() => this.RemoveFilter(index)">✕</button>
                    </div>
                }
                <div class="toolbar">
                    <button class="btn primary sm" type="button" disabled="@this.busy" @onclick="() => this.Load(false)">Apply filters</button>
                    <button class="btn ghost sm" type="button" @onclick="this.ClearFilters">Clear all</button>
                </div>
            </div>
        }

        @if (this.showColumns)
        {
            <div class="note" style="margin-top: 8px">
                <strong>Columns</strong>
                <div class="toolbar" style="margin-top: 6px">
                    @foreach (var field in this.schema?.Fields ?? [])
                    {
                        <label class="check">
                            <input type="checkbox" checked="@this.columns.Contains(field.Path)"
                                   @onchange="e => this.ToggleColumn(field.Path, (bool?)e.Value == true)" />
                            <span class="mono">@field.Path</span>
                            <span class="faint">@field.PercentPresent%</span>
                        </label>
                    }
                </div>
            </div>
        }
    </div>

    @if (this.error is not null)
    {
        <div class="body"><div class="note err"><span class="mono">@this.error</span></div></div>
    }

    @if (this.vectorWarning is not null)
    {
        <div class="body">
            <div class="note warn">
                @this.vectorWarning
                <a href="@this.VectorsHref">Open the Vectors tab</a> to see and repair the difference.
            </div>
        </div>
    }

    @if (this.page is { } current)
    {
        <div class="body flush tablewrap">
            <table class="data">
                <thead>
                    <tr>
                        @if (!this.readOnly)
                        {
                            <th style="width: 28px">
                                <input type="checkbox" checked="@this.AllSelected"
                                       @onchange="e => this.ToggleAll((bool?)e.Value == true)" />
                            </th>
                        }
                        <th>@this.SortHeader("Id", "Id")</th>
                        @foreach (var column in this.columns)
                        {
                            <th>@this.SortHeader(column, column)</th>
                        }
                        <th>@this.SortHeader("Updated", "UpdatedAt")</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in current.Rows)
                    {
                        var flagged = this.softDelete is not null && DocumentAdminService.IsFlagged(row, this.softDelete);
                        <tr class="@(this.selected.Contains(row.Id) ? "selected" : "") @(flagged ? "deleted" : "")">
                            @if (!this.readOnly)
                            {
                                <td>
                                    <input type="checkbox" checked="@this.selected.Contains(row.Id)"
                                           @onchange="e => this.ToggleRow(row.Id, (bool?)e.Value == true)" />
                                </td>
                            }
                            <td class="cell-mono">
                                <a href="javascript:void(0)" @onclick="() => this.StartEdit(row)" @onclick:preventDefault>
                                    <span class="cellval">@row.Id</span>
                                </a>
                                @if (flagged)
                                {
                                    <span class="badge ro" title="Flagged on @this.softDelete!.PropertyPath">deleted</span>
                                }
                            </td>
                            @foreach (var column in this.columns)
                            {
                                <td class="cell-mono">@Render(row.Read(column))</td>
                            }
                            <td class="faint nowrap">@(row.UpdatedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                            <td class="actions nowrap">
                                <button class="btn ghost sm" type="button" @onclick="() => this.ToggleJson(row)">
                                    @(this.expanded == row.Id ? "Hide" : "JSON")
                                </button>
                                @if (this.HasHistory)
                                {
                                    <a class="btn ghost sm" href="@this.SidecarHref("history", row.Id)">History</a>
                                }
                                @if (this.HasBlobs)
                                {
                                    <a class="btn ghost sm" href="@this.SidecarHref("blobs", row.Id)">Blobs</a>
                                }
                                @if (this.HasGeometry)
                                {
                                    <a class="btn ghost sm" href="@this.SidecarHref("geometry", row.Id)">Geometry</a>
                                }
                                <button class="btn ghost sm" type="button" @onclick="() => this.StartEdit(row)">
                                    @(this.readOnly ? "View" : "Edit")
                                </button>
                                @if (!this.readOnly && flagged)
                                {
                                    <button class="btn ghost sm" type="button" @onclick="() => this.Restore(row)">Restore</button>
                                }
                                @if (!this.readOnly)
                                {
                                    <button class="btn ghost sm" type="button" @onclick="() => this.AskDelete(row)">Delete</button>
                                }
                            </td>
                        </tr>

                        @if (this.expanded == row.Id)
                        {
                            <tr>
                                <td colspan="99" class="preview-cell">
                                    <JsonView Json="@row.Json" Label="@row.Id" ProfileId="@this.ProfileId" />
                                </td>
                            </tr>
                        }
                    }

                    @if (current.Rows.Count == 0)
                    {
                        <tr>
                            <td colspan="99" class="faint" style="height: 90px; text-align: center">
                                No documents match.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="pager">
            <button class="btn sm" type="button" disabled="@(current.Page <= 1 || this.busy)" @onclick="() => this.GoTo(1)">« First</button>
            <button class="btn sm" type="button" disabled="@(current.Page <= 1 || this.busy)" @onclick="() => this.GoTo(current.Page - 1)">‹ Prev</button>
            <span class="mono">@current.Page / @current.PageCount</span>
            <button class="btn sm" type="button" disabled="@(current.Page >= current.PageCount || this.busy)" @onclick="() => this.GoTo(current.Page + 1)">Next ›</button>
            <button class="btn sm" type="button" disabled="@(current.Page >= current.PageCount || this.busy)" @onclick="() => this.GoTo(current.PageCount)">Last »</button>

            @if (this.selected.Count > 0)
            {
                <button class="btn sm danger" type="button" disabled="@this.busy" @onclick="this.DeleteSelected">
                    @(this.confirmBulk
                        ? $"Really {(this.softDelete is null ? "delete" : "flag")} {this.selected.Count}?"
                        : $"{(this.softDelete is null ? "Delete" : "Flag deleted")} {this.selected.Count} selected")
                </button>
            }

            <span class="info">@current.TotalCount.ToString("N0") document(s)</span>
        </div>
    }
    else if (this.busy)
    {
        <div class="empty">Loading…</div>
    }
</div>

@if (this.dialogOpen)
{
    <DocumentDialog ProfileId="@this.ProfileId" Table="@this.Table" TypeName="@this.TypeName"
                    Row="@this.editing" OnSaved="this.OnDialogSaved" OnCancelled="() => this.dialogOpen = false" />
}

@if (this.pendingDelete is not null)
{
    @* A delete takes the document and every sidecar row keyed to it, and none of that comes back.
       Saying which sidecars up front is the difference between a confirmation and a speed bump. *@
    <div class="overlay" @onclick="() => this.pendingDelete = null">
        <div class="dialog" style="max-width: 520px" @onclick:stopPropagation>
            <header>
                <span>Delete document</span>
                <span class="badge">@this.TypeName</span>
                <span class="spacer"></span>
                <button class="btn ghost sm" type="button" @onclick="() => this.pendingDelete = null">✕</button>
            </header>

            <div class="body">
                @if (this.softDelete is { } declared)
                {
                    @* The application only ever flags this type, so flagging is what "delete" means here.
                       Removing the row for real stays available - as a second, deliberate choice. *@
                    <p>
                        Delete <strong class="mono">@this.pendingDelete.Id</strong>?
                        <span class="mono">@this.TypeName</span> is declared for soft delete on
                        <span class="mono">@declared.PropertyPath</span>, so this flags the document the way
                        the application would - it stays in the table and can be restored.
                    </p>
                }
                else
                {
                    <p>
                        Permanently delete <strong class="mono">@this.pendingDelete.Id</strong>?
                        This cannot be undone.
                    </p>
                }

                @if (this.DeleteAlsoRemoves.Count > 0)
                {
                    <div class="note warn">
                        Also removed: @string.Join(", ", this.DeleteAlsoRemoves).
                    </div>
                }

                @if (this.HasHistory)
                {
                    <div class="note">
                        A <span class="mono">Removed</span> version is appended to the history sidecar, so the
                        document stays readable as of an earlier time.
                    </div>
                }
            </div>

            <footer>
                @if (this.softDelete is not null)
                {
                    <button class="btn danger" type="button" disabled="@this.busy" @onclick="() => this.ConfirmDelete(false)">Flag deleted</button>
                    <button class="btn ghost danger" type="button" disabled="@this.busy" @onclick="() => this.ConfirmDelete(true)">Delete permanently</button>
                }
                else
                {
                    <button class="btn danger" type="button" disabled="@this.busy" @onclick="() => this.ConfirmDelete(true)">Delete</button>
                }
                <button class="btn ghost" type="button" @onclick="() => this.pendingDelete = null">Cancel</button>
            </footer>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public string ProfileId { get; set; } = "";
    [Parameter, EditorRequired] public string Table { get; set; } = "";
    [Parameter, EditorRequired] public string TypeName { get; set; } = "";

    InferredSchema? schema;
    DocumentPage? page;
    readonly List<string> columns = [];
    readonly List<BrowseFilter> filters = [];
    readonly HashSet<string> selected = [];

    string search = "";
    int pageSize = 25;

    /// <summary>The declared flag for this type, or null. Read from the connection, never inferred.</summary>
    SoftDeleteFlag? softDelete;

    DeletedFilter deletedFilter = DeletedFilter.Live;
    int pageNumber = 1;
    BrowseSort sort = new("UpdatedAt", true, true);
    bool showColumns;
    bool busy;
    bool readOnly;
    string? error;

    /// <summary>
    /// Set when a save could not carry the vector sidecar with it. Not an error - the document was
    /// written - but leaving it unsaid would mean the tool knowingly desynchronised a search index.
    /// </summary>
    string? vectorWarning;

    bool dialogOpen;
    DocumentRow? editing;

    /// <summary>Id of the row whose body is expanded inline, if any.</summary>
    string? expanded;

    /// <summary>Set when the table has a history sidecar, so each row can link to its versions.</summary>
    [Parameter] public bool HasHistory { get; set; }

    /// <summary>Set when the table has a blob sidecar, so each row can link to its own payloads.</summary>
    [Parameter] public bool HasBlobs { get; set; }

    /// <summary>Set when this type stores geometry, so each row can link to its own shape on the map.</summary>
    [Parameter] public bool HasGeometry { get; set; }

    /// <summary>Set when this type has a vector sidecar. Only used to say so before a delete.</summary>
    [Parameter] public bool HasVectors { get; set; }

    /// <summary>
    /// Set when the table has a spatial index sidecar. Deliberately not <see cref="HasGeometry"/>, which
    /// only says the body holds GeoJSON - an unmapped type has shapes but no index row to lose.
    /// </summary>
    [Parameter] public bool HasSpatialIndex { get; set; }

    /// <summary>The row awaiting delete confirmation, if any.</summary>
    DocumentRow? pendingDelete;

    /// <summary>
    /// The sidecar rows a delete takes with the document, named so the confirmation says what it costs.
    /// History is left out on purpose - it gains a tombstone rather than losing a row, which the dialog
    /// says separately.
    /// </summary>
    List<string> DeleteAlsoRemoves
    {
        get
        {
            var parts = new List<string>();
            if (this.HasBlobs)
                parts.Add("its blob payloads");
            if (this.HasVectors)
                parts.Add("its vector embedding");
            if (this.HasSpatialIndex)
                parts.Add("its spatial index row");
            return parts;
        }
    }

    /// <summary>
    /// A deep link into a sidecar tab scoped to one row. The sidecar views are keyed by document id, so
    /// the whole-type view they open on is the same view narrowed - not a different screen.
    /// </summary>
    string SidecarHref(string tab, string id)
        => $"/db/{Uri.EscapeDataString(this.ProfileId)}/{Uri.EscapeDataString(this.Table)}" +
           $"/{Uri.EscapeDataString(this.TypeName)}?tab={tab}&doc={Uri.EscapeDataString(id)}";

    string VectorsHref
        => $"/db/{Uri.EscapeDataString(this.ProfileId)}/{Uri.EscapeDataString(this.Table)}" +
           $"/{Uri.EscapeDataString(this.TypeName)}?tab=vectors";

    bool confirmBulk;

    string cacheKey = "";

    IEnumerable<string> AllPaths => DocumentAdminService.EnvelopeColumnNames
        .Concat(this.schema?.Fields.Select(f => f.Path) ?? [])
        .Distinct();

    bool AllSelected => this.page is { Rows.Count: > 0 } p && p.Rows.All(r => this.selected.Contains(r.Id));

    protected override async Task OnParametersSetAsync()
    {
        var key = $"{this.ProfileId}|{this.Table}|{this.TypeName}";
        if (key == this.cacheKey)
            return;

        // Switching type resets the view: another type's columns and filters mean nothing here.
        this.cacheKey = key;
        this.columns.Clear();
        this.filters.Clear();
        this.selected.Clear();
        this.search = "";
        this.pageNumber = 1;
        this.schema = null;
        this.page = null;

        var profile = await this.Profiles.Get(this.ProfileId);
        this.readOnly = profile?.ReadOnly ?? false;

        await this.Load(true);
    }

    async Task Load(bool reinferSchema)
    {
        this.busy = true;
        this.error = null;
        this.confirmBulk = false;
        this.pendingDelete = null;
        try
        {
            this.softDelete = await this.Admin.GetSoftDeleteFlag(this.ProfileId, this.TypeName);

            if (reinferSchema || this.schema is null)
            {
                this.schema = await this.Admin.InferSchema(this.ProfileId, this.Table, this.TypeName);
                if (this.columns.Count == 0)
                    this.columns.AddRange(DocumentAdminService.DefaultColumns(this.schema));
            }

            this.page = await this.Admin.Browse(this.ProfileId, this.Table, this.TypeName, this.BuildQuery());
        }
        catch (Exception ex)
        {
            this.error = ex.Message;
            this.page = null;
        }
        finally
        {
            this.busy = false;
        }
    }

    BrowseQuery BuildQuery() => new()
    {
        Page = this.pageNumber,
        PageSize = this.pageSize,
        Sort = this.sort,
        Filters = [.. this.filters.Where(f => !string.IsNullOrWhiteSpace(f.Path))],
        Search = this.search,
        SearchPaths = this.schema is null ? ["Id"] : DocumentAdminService.SearchableColumns(this.schema),
        Deleted = this.softDelete is null ? DeletedFilter.All : this.deletedFilter
    };

    RenderFragment SortHeader(string label, string path) => builder =>
    {
        var active = this.sort.Path == path;
        builder.OpenElement(0, "button");
        builder.AddAttribute(1, "type", "button");
        builder.AddAttribute(2, "onclick", EventCallback.Factory.Create(this, () => this.SortBy(path)));
        builder.AddContent(3, label);
        builder.AddContent(4, active ? (this.sort.Descending ? " ▼" : " ▲") : "");
        builder.CloseElement();
    };

    async Task SortBy(string path)
    {
        this.sort = this.sort.Path == path
            ? this.sort with { Descending = !this.sort.Descending }
            : new BrowseSort(path, false, DocumentAdminService.IsEnvelopeColumn(path));

        this.pageNumber = 1;
        await this.Load(false);
    }

    async Task GoTo(int target)
    {
        this.pageNumber = Math.Max(1, target);
        this.selected.Clear();
        await this.Load(false);
    }

    async Task OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            this.pageNumber = 1;
            await this.Load(false);
        }
    }

    void AddFilter() => this.filters.Add(new BrowseFilter("", FilterOperator.Equals, ""));

    void UpdateFilter(int index, string? path = null, string? op = null, string? value = null)
    {
        var filter = this.filters[index];
        if (path is not null)
            filter = filter with { Path = path };

        if (op is not null && Enum.TryParse<FilterOperator>(op, out var parsed))
            filter = filter with { Operator = parsed };

        if (value is not null)
            filter = filter with { Value = value };

        this.filters[index] = filter;
    }

    async Task RemoveFilter(int index)
    {
        this.filters.RemoveAt(index);
        this.pageNumber = 1;
        await this.Load(false);
    }

    async Task ClearFilters()
    {
        this.filters.Clear();
        this.pageNumber = 1;
        await this.Load(false);
    }

    async Task ToggleColumn(string path, bool on)
    {
        if (on)
            this.columns.Add(path);
        else
            this.columns.Remove(path);

        await Task.CompletedTask;
    }

    void ToggleRow(string id, bool on)
    {
        if (on)
            this.selected.Add(id);
        else
            this.selected.Remove(id);

        this.confirmBulk = false;
    }

    void ToggleAll(bool on)
    {
        if (this.page is null)
            return;

        foreach (var row in this.page.Rows)
        {
            if (on)
                this.selected.Add(row.Id);
            else
                this.selected.Remove(row.Id);
        }

        this.confirmBulk = false;
    }

    void StartInsert()
    {
        this.editing = null;
        this.dialogOpen = true;
    }

    void StartEdit(DocumentRow row)
    {
        this.editing = row;
        this.dialogOpen = true;
    }

    /// <summary>
    /// Expands one row to show its whole body. One at a time: the grid is the thing you are scanning,
    /// and several open bodies push it off the screen.
    /// </summary>
    void ToggleJson(DocumentRow row) => this.expanded = this.expanded == row.Id ? null : row.Id;

    async Task OnDialogSaved(VectorSyncOutcome outcome)
    {
        this.dialogOpen = false;
        this.vectorWarning = outcome switch
        {
            VectorSyncOutcome.Unavailable =>
                "The document was saved, but this tool could not update the vector sidecar, so it now holds the previous embedding.",
            VectorSyncOutcome.Ambiguous =>
                "The document was saved, but its body held no single embedding to sync, so the vector sidecar was left as it was.",
            _ => null
        };

        await this.Load(true);
        await this.Events.NotifyDataChanged();
    }

    void AskDelete(DocumentRow row) => this.pendingDelete = row;

    async Task ConfirmDelete(bool permanent)
    {
        var row = this.pendingDelete;
        if (row is null)
            return;

        this.pendingDelete = null;
        await this.DeleteOne(row, permanent);
    }

    async Task DeleteOne(DocumentRow row, bool permanent)
    {
        this.busy = true;
        try
        {
            if (this.softDelete is not null && !permanent)
                await this.Admin.SoftDeleteDocuments(this.ProfileId, this.Table, this.TypeName, [row.Id]);
            else
                await this.Admin.DeleteDocuments(this.ProfileId, this.Table, this.TypeName, [row.Id], permanent: true);

            this.selected.Remove(row.Id);
            await this.Load(false);
            await this.Events.NotifyDataChanged();
        }
        catch (Exception ex)
        {
            this.error = ex.Message;
        }
        finally
        {
            this.busy = false;
        }
    }

    /// <summary>Clears the declared flag - false for a boolean, null for a timestamp.</summary>
    async Task Restore(DocumentRow row)
    {
        this.busy = true;
        try
        {
            await this.Admin.RestoreDocuments(this.ProfileId, this.Table, this.TypeName, [row.Id]);
            await this.Load(false);
            await this.Events.NotifyDataChanged();
        }
        catch (Exception ex)
        {
            this.error = ex.Message;
        }
        finally
        {
            this.busy = false;
        }
    }

    async Task DeleteSelected()
    {
        // A bulk delete is not undoable, so the first click only arms the button.
        if (!this.confirmBulk)
        {
            this.confirmBulk = true;
            return;
        }

        this.busy = true;
        this.confirmBulk = false;
        try
        {
            // A bulk delete of a declared type flags, like every other delete of it. Removing rows for real
            // in bulk is not offered: it is the one action here that cannot be walked back.
            if (this.softDelete is not null)
                await this.Admin.SoftDeleteDocuments(this.ProfileId, this.Table, this.TypeName, [.. this.selected]);
            else
                await this.Admin.DeleteDocuments(this.ProfileId, this.Table, this.TypeName, [.. this.selected], permanent: true);

            this.selected.Clear();
            await this.Load(false);
            await this.Events.NotifyDataChanged();
        }
        catch (Exception ex)
        {
            this.error = ex.Message;
        }
        finally
        {
            this.busy = false;
        }
    }

    static string Label(FilterOperator op) => op switch
    {
        FilterOperator.Equals => "=",
        FilterOperator.NotEquals => "≠",
        FilterOperator.Contains => "contains",
        FilterOperator.StartsWith => "starts with",
        FilterOperator.EndsWith => "ends with",
        FilterOperator.GreaterThan => ">",
        FilterOperator.GreaterOrEqual => "≥",
        FilterOperator.LessThan => "<",
        FilterOperator.LessOrEqual => "≤",
        FilterOperator.IsNull => "is null",
        _ => "is not null"
    };

    static RenderFragment Render(System.Text.Json.Nodes.JsonNode? node) => builder =>
    {
        if (node is null)
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "nullish");
            builder.AddContent(2, "null");
            builder.CloseElement();
            return;
        }

        // Grids never decrypt, whatever keys the connection holds - a reveal is a deliberate act, and
        // a page of 25 rows is the opposite of one. The document view offers it per value.
        if (JsonDisplay.TryEncryptedSummary(node, out var encrypted))
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "cellval enc");
            builder.AddAttribute(2, "title", "Field-level encryption envelope - open the document to see the ciphertext");
            builder.AddContent(3, $"🔒 {encrypted}");
            builder.CloseElement();
            return;
        }

        // An embedding column would otherwise put its whole array into the cell *and* into the title
        // attribute - tens of kilobytes per row, over the circuit, to render numbers nobody reads.
        if (JsonHtml.TryVectorSummary(node, out var summary))
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "cellval jt-vector");
            builder.AddAttribute(2, "title", summary);
            builder.AddContent(3, summary);
            builder.CloseElement();
            return;
        }

        var text = node is System.Text.Json.Nodes.JsonValue value
                   && value.GetValueKind() == System.Text.Json.JsonValueKind.String
            ? value.GetValue<string>()
            : node.ToJsonString();

        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", "cellval");
        builder.AddAttribute(2, "title", text);
        builder.AddContent(3, text);
        builder.CloseElement();
    };
}
