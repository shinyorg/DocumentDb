<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>$(BaseTargetFramework)</TargetFramework>
        <RootNamespace>ShinyDocDbMyAdmin</RootNamespace>
        <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
        <Description>A phpMyAdmin-style web front end for Shiny.DocumentDb stores - browse and edit documents, run SQL, manage JSON indexes, inspect geometry and blobs. Shipped as a container image, not a NuGet package.</Description>

        <!--
          Blazor Server is reflection-heavy, so the repo-wide AOT/trim posture from
          src/Directory.Build.props does not apply. This is an app, not a library someone trims into.
        -->
        <IsAotCompatible>false</IsAotCompatible>
        <EnableAotAnalyzer>false</EnableAotAnalyzer>
        <EnableTrimAnalyzer>false</EnableTrimAnalyzer>

        <!--
          Deliberately never packed. This app ships as the ghcr.io/shinyorg/shinydocdbmyadmin container
          image (see Dockerfile). A NuGet form of it came out at ~120MB - almost entirely native provider
          binaries for every RID - to deliver what one image delivers for the platform you are actually on.
          The terminal front end (src/ShinyDocDbMyAdmin.Tui) is the installable form of the same tool.
        -->
        <IsPackable>false</IsPackable>

        <!-- An app, not a library: no public API to document and no source package to ship. -->
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <IncludeSource>false</IncludeSource>
    </PropertyGroup>

    <ItemGroup>
        <!--
          The admin layer itself - connection profiles, the document/schema/index/sidecar services and
          import/export - lives in Core so the terminal front end runs on exactly the same code, down to
          the profile store, the secret key and the connection bundle format. The provider
          ProjectReferences, the assistant's client packages and the SQLitePCLRaw bundle selection come
          with it.
        -->
        <ProjectReference Include="..\ShinyDocDbMyAdmin.Core\ShinyDocDbMyAdmin.Core.csproj"/>
    </ItemGroup>

    <!--
      The demo instance's sample, carried inside the image so demo mode is one flag rather than a
      seeding sidecar that has to agree with the app about paths and ordering. These are the same two
      files deploy/docker-compose.yml used to feed to sqlite3; deploy/demo/seed-demo.py and
      tools/ShinyDocDbMyAdmin.DemoVolume remain the things that produce them.

      ~5MB of SQL text, which the image layer compresses well. It only costs anything at build time -
      DemoDatabaseBuilder reads them once, on the first start of a demo instance.
    -->
    <ItemGroup>
        <EmbeddedResource Include="..\..\deploy\demo\seed-demo.sql" LogicalName="ShinyDocDbMyAdmin.Demo.seed-demo.sql"/>
        <EmbeddedResource Include="..\..\deploy\demo\seed-demo-volume.sql" LogicalName="ShinyDocDbMyAdmin.Demo.seed-demo-volume.sql"/>
    </ItemGroup>

    <!-- ChatView, which AiChatSession bridges the assistant to. -->
    <ItemGroup>
        <PackageReference Include="Shiny.Blazor.Controls"/>
    </ItemGroup>

</Project>
