<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>$(LibraryTargetFrameworks)</TargetFrameworks>
        <Description>.NET Aspire AppHost integration for Shiny.DocumentDb — model a document store as a resource, pick its backend (Postgres/SQL Server/MySQL/SQLite), and gate seeding. JIT-only (Aspire hosting is reflection-heavy).</Description>
        <PackageTags>aspire;documentdb;hosting;apphost;shiny</PackageTags>
        <IsAotCompatible>false</IsAotCompatible>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Shiny.DocumentDb.Aspire.Tests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Aspire.Hosting" />
        <PackageReference Include="Aspire.Hosting.PostgreSQL" />
        <PackageReference Include="Aspire.Hosting.SqlServer" />
        <PackageReference Include="Aspire.Hosting.MySql" />

        <!--
          WithSeeder keeps its "already seeded" marker inside the backing database, so the AppHost needs
          a raw ADO connection per supported kind. Npgsql/SqlClient/MySqlConnector already arrive
          transitively via the Aspire hosting health checks - reference them directly so the versions are
          ours, not whatever those packages happen to float to.
        -->
        <PackageReference Include="Npgsql" />
        <PackageReference Include="Microsoft.Data.SqlClient" />
        <PackageReference Include="MySqlConnector" />
        <PackageReference Include="Microsoft.Data.Sqlite" />
    </ItemGroup>

    <!--
      AddDocumentDbAdmin defaults its image tag to the version this package shipped as, so it needs
      that version at runtime. AssemblyInformationalVersion carries SourceLink's "+<commit>" suffix,
      so stamp $(PackageVersion) in directly. release.yml sets it from the v* tag (-p:Version), and the
      admin image is pushed under the same tag.
    -->
    <ItemGroup>
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>NuGetPackageVersion</_Parameter1>
            <_Parameter2>$(PackageVersion)</_Parameter2>
        </AssemblyAttribute>
    </ItemGroup>
</Project>
