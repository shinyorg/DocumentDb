<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>$(BaseTargetFramework)</TargetFramework>
        <IsPackable>false</IsPackable>
        <RootNamespace>Sample.Aspire.AppHost</RootNamespace>
        <!-- Aspire hosting is reflection-heavy and an AppHost is never trimmed/AOT'd. -->
        <EnableAotAnalyzer>false</EnableAotAnalyzer>
        <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Aspire.Hosting.AppHost" />
        <PackageReference Include="Aspire.Hosting.Dotnet" />
    </ItemGroup>

    <!--
      Ordinary compile-time references - the seed callback's store, provider and models. The API is NOT
      referenced here: it is added as a resource by path with AddDotnetProject in AppHost.cs.
    -->
    <ItemGroup>
        <ProjectReference Include="..\..\..\src\Shiny.DocumentDb.Aspire.Hosting\Shiny.DocumentDb.Aspire.Hosting.csproj" />
        <ProjectReference Include="..\..\..\src\Shiny.DocumentDb\Shiny.DocumentDb.csproj" />
        <ProjectReference Include="..\..\..\src\Shiny.DocumentDb.PostgreSql\Shiny.DocumentDb.PostgreSql.csproj" />
        <ProjectReference Include="..\Sample.Aspire.Domain\Sample.Aspire.Domain.csproj" />
    </ItemGroup>
</Project>
