<Project Sdk="Microsoft.NET.Sdk">
    <Sdk Name="Aspire.AppHost.Sdk" />

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>$(BaseTargetFramework)</TargetFramework>
        <IsAspireHost>true</IsAspireHost>
        <IsPackable>false</IsPackable>
        <RootNamespace>Sample.Aspire.AppHost</RootNamespace>
        <!-- Aspire hosting is reflection-heavy and an AppHost is never trimmed/AOT'd. -->
        <EnableAotAnalyzer>false</EnableAotAnalyzer>
        <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Aspire.Hosting.AppHost" />
    </ItemGroup>

    <!--
      Aspire.AppHost.Sdk treats EVERY ProjectReference as an app resource by default: it generates the
      Projects.* metadata type and sets ReferenceOutputAssembly=false, so the assembly itself is NOT
      referenced. Anything the AppHost needs to *compile* against - the seed callback's store, provider
      and models - has to opt out with IsAspireProjectResource="false".
    -->
    <ItemGroup>
        <ProjectReference Include="..\..\..\src\Shiny.DocumentDb.Aspire.Hosting\Shiny.DocumentDb.Aspire.Hosting.csproj" IsAspireProjectResource="false" />
        <ProjectReference Include="..\..\..\src\Shiny.DocumentDb\Shiny.DocumentDb.csproj" IsAspireProjectResource="false" />
        <ProjectReference Include="..\..\..\src\Shiny.DocumentDb.PostgreSql\Shiny.DocumentDb.PostgreSql.csproj" IsAspireProjectResource="false" />
        <ProjectReference Include="..\Sample.Aspire.Domain\Sample.Aspire.Domain.csproj" IsAspireProjectResource="false" />

        <!-- The one that IS a resource - this is what makes Projects.Sample_Aspire_Api exist. -->
        <ProjectReference Include="..\Sample.Aspire.Api\Sample.Aspire.Api.csproj" IsAspireProjectResource="true" />
    </ItemGroup>
</Project>
