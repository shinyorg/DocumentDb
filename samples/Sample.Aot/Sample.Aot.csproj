<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>$(BaseTargetFramework)</TargetFramework>
        <IsPackable>false</IsPackable>
        <!-- The repo turns these on for Release; native compilation rejects the first and a sample owes no XML docs. -->
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>

        <!--
          The AOT regression guard. `dotnet publish samples/Sample.Aot -r <rid> -c Release` runs the real
          ILC compiler over the library, which catches what the Roslyn analyzers cannot: warnings coming out
          of dependencies, and anything only reachable through a call graph. Publish must stay warning-free.
        -->
        <PublishAot>true</PublishAot>
        <!-- Report every site rather than collapsing to one "assembly produced warnings" line. -->
        <TrimmerSingleWarn>false</TrimmerSingleWarn>
        <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
        <!-- A trim/AOT warning here is a build break, which is the entire point of this project. -->
        <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2050;IL2055;IL2057;IL2058;IL2059;IL2060;IL2062;IL2063;IL2064;IL2065;IL2066;IL2067;IL2068;IL2069;IL2070;IL2071;IL2072;IL2073;IL2074;IL2075;IL2076;IL2077;IL2078;IL2079;IL2080;IL2081;IL2082;IL2083;IL2084;IL2085;IL2086;IL2087;IL2088;IL2089;IL2090;IL2091;IL2092;IL2093;IL2094;IL2095;IL2096;IL2097;IL2098;IL2099;IL3000;IL3001;IL3002;IL3050;IL3051;IL3052;IL3053;IL3054;IL3055;IL3056</WarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Shiny.DocumentDb\Shiny.DocumentDb.csproj" />
        <ProjectReference Include="..\..\src\Shiny.DocumentDb.Sqlite\Shiny.DocumentDb.Sqlite.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection"/>
        <!-- PublishAot adds ILCompiler implicitly. Under central package management an implicit reference
             must carry its version here rather than in Directory.Packages.props (NU1009), and
             BundledNETCoreAppPackageVersion tracks the installed SDK so it never drifts on an SDK bump. -->
        <PackageReference Update="Microsoft.DotNet.ILCompiler" Version="$(BundledNETCoreAppPackageVersion)"/>
    </ItemGroup>
</Project>
