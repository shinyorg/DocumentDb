<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <TargetFramework>$(BaseTargetFramework)</TargetFramework>
        <IsPackable>false</IsPackable>
        <!-- The MCP SDK's transport layer is reflection-heavy; see the note on Shiny.DocumentDb.Mcp. -->
        <EnableAotAnalyzer>false</EnableAotAnalyzer>
        <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Bogus" />
    </ItemGroup>

    <!--
      The model, the JSON context and the seeder are the OData sample's, linked rather than copied — so the
      OData, REST and MCP samples all sit over byte-identical data and can be compared directly.
    -->
    <ItemGroup>
        <Compile Include="..\Sample.ODataApi\Models.cs" Link="Shared\Models.cs" />
        <Compile Include="..\Sample.ODataApi\SampleJsonContext.cs" Link="Shared\SampleJsonContext.cs" />
        <Compile Include="..\Sample.ODataApi\SeedData.cs" Link="Shared\SeedData.cs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Shiny.DocumentDb\Shiny.DocumentDb.csproj" />
        <ProjectReference Include="..\..\src\Shiny.DocumentDb.Sqlite\Shiny.DocumentDb.Sqlite.csproj" />
        <ProjectReference Include="..\..\src\Shiny.DocumentDb.Mcp\Shiny.DocumentDb.Mcp.csproj" />
    </ItemGroup>
</Project>
