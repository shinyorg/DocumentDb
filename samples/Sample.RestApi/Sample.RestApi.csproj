<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <TargetFramework>$(BaseTargetFramework)</TargetFramework>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Bogus" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    </ItemGroup>

    <!--
      The model, the JSON context and the seeder are the OData sample's, linked rather than copied, so the two
      APIs sit over byte-identical data and can be compared request for request.
    -->
    <ItemGroup>
        <Compile Include="..\Sample.ODataApi\Models.cs" Link="Shared\Models.cs" />
        <Compile Include="..\Sample.ODataApi\SampleJsonContext.cs" Link="Shared\SampleJsonContext.cs" />
        <Compile Include="..\Sample.ODataApi\SeedData.cs" Link="Shared\SeedData.cs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Shiny.DocumentDb\Shiny.DocumentDb.csproj" />
        <ProjectReference Include="..\..\src\Shiny.DocumentDb.Sqlite\Shiny.DocumentDb.Sqlite.csproj" />
        <ProjectReference Include="..\..\src\Shiny.DocumentDb.AspNetCore\Shiny.DocumentDb.AspNetCore.csproj" />
    </ItemGroup>
</Project>
