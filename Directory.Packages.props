<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <AspireVersion>17.0.0</AspireVersion>
        <MicrosoftExtensionsAIVersion>11.0.1</MicrosoftExtensionsAIVersion>
        <!-- MEVD ships on its own cadence from MEAI, so it gets its own property rather than riding above. -->
        <MicrosoftExtensionsVectorDataVersion>11.0.1</MicrosoftExtensionsVectorDataVersion>
        <MicrosoftExtensionsVersion>11.0.0</MicrosoftExtensionsVersion>
        <TestcontainersVersion>4.17.0</TestcontainersVersion>
    </PropertyGroup>
    <ItemGroup>
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0"/>
        <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0"/>
        <PackageVersion Include="Microsoft.Azure.Cosmos" Version="3.64.0"/>
        <PackageVersion Include="Azure.Data.Tables" Version="12.13.0"/>
        <PackageVersion Include="AWSSDK.DynamoDBv2" Version="4.1.0.3"/>
        <PackageVersion Include="AWSSDK.DynamoDBStreams" Version="4.1.1.1"/>
        <PackageVersion Include="Newtonsoft.Json" Version="13.0.4"/>
        <PackageVersion Include="Microsoft.Data.Sqlite" Version="11.0.0"/>
        <PackageVersion Include="Microsoft.Data.Sqlite.Core" Version="11.0.0"/>
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(MicrosoftExtensionsVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.Diagnostics" Version="$(MicrosoftExtensionsVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="$(MicrosoftExtensionsVersion)"/>
        <!-- ASP.NET Core packages only target their own .NET, so the net10 build of the IndexedDb library pins the 10.x line. -->
        <PackageVersion Include="Microsoft.JSInterop" Version="11.0.0" Condition="'$(TargetFramework)' != 'net10.0'"/>
        <PackageVersion Include="Microsoft.JSInterop" Version="10.0.15" Condition="'$(TargetFramework)' == 'net10.0'"/>
        <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="$(MicrosoftExtensionsAIVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.VectorData.Abstractions" Version="$(MicrosoftExtensionsVectorDataVersion)"/>
        <PackageVersion Include="Microsoft.Data.SqlClient" Version="8.0.0"/>
        <PackageVersion Include="MySqlConnector" Version="3.0.0"/>
        <PackageVersion Include="Npgsql" Version="11.0.0"/>
        <PackageVersion Include="Oracle.ManagedDataAccess.Core" Version="23.26.401"/>
        <PackageVersion Include="LiteDB" Version="5.0.21"/>
        <PackageVersion Include="DuckDB.NET.Data.Full" Version="1.5.6.1"/>
        <PackageVersion Include="MongoDB.Driver" Version="3.14.1"/>
        <PackageVersion Include="RavenDB.Client" Version="7.2.9"/>
        <PackageVersion Include="Google.Cloud.Firestore" Version="4.7.0"/>
        <PackageVersion Include="NRedisStack" Version="1.8.0"/>
        <!-- SQLCipher-compatible encryption for Shiny.DocumentDb.Sqlite.SqlCipher. SQLite3 Multiple Ciphers on the
             same SQLitePCLRaw 3.x core Microsoft.Data.Sqlite 11 brings (SQLitePCLRaw 3.x ships no e_sqlcipher). -->
        <PackageVersion Include="SQLite3MC.PCLRaw.bundle" Version="2.7.1"/>
        <PackageVersion Include="Microsoft.Orleans.Runtime" Version="10.4.2"/>
        <PackageVersion Include="Microsoft.Orleans.Reminders" Version="10.4.2"/>
        <PackageVersion Include="Microsoft.Orleans.Streaming" Version="10.4.2"/>
        <PackageVersion Include="JsonSchema.Net" Version="9.7.0"/>
        <PackageVersion Include="Shiny.Data.Sync" Version="7.2.0"/>
        <PackageVersion Include="Microsoft.AspNetCore.OData" Version="9.5.0"/>
        <!-- In-process host for the endpoint/MCP test suites (WebApplication + UseTestServer). -->
        <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="11.0.0"/>
        <!-- The REST sample renders its own OpenAPI document; the endpoints only emit metadata. -->
        <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0"/>
        <PackageVersion Include="Aspire.Hosting" Version="$(AspireVersion)"/>
        <PackageVersion Include="Aspire.Hosting.AppHost" Version="$(AspireVersion)"/>
        <PackageVersion Include="Aspire.Hosting.Dotnet" Version="$(AspireVersion)"/>
        <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="$(AspireVersion)"/>
        <PackageVersion Include="Aspire.Hosting.SqlServer" Version="$(AspireVersion)"/>
        <PackageVersion Include="Aspire.Hosting.MySql" Version="$(AspireVersion)"/>
        <PackageVersion Include="OpenTelemetry" Version="1.21.0"/>
        <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0"/>
    </ItemGroup>
    <ItemGroup>
        <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="11.0.0"/>
        <PackageVersion Include="Microsoft.Extensions.Hosting" Version="$(MicrosoftExtensionsVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="$(MicrosoftExtensionsVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="$(MicrosoftExtensionsVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.Logging" Version="$(MicrosoftExtensionsVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.Logging.Configuration" Version="$(MicrosoftExtensionsVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.Configuration" Version="$(MicrosoftExtensionsVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="$(MicrosoftExtensionsVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="$(MicrosoftExtensionsVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="$(MicrosoftExtensionsVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.AI" Version="$(MicrosoftExtensionsAIVersion)"/>
        <!-- MCP: the SDK is young, so both packages are pinned together and the adapter layer stays thin. -->
        <PackageVersion Include="ModelContextProtocol" Version="2.4.0"/>
        <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.4.0"/>
        <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="$(MicrosoftExtensionsAIVersion)"/>
        <PackageVersion Include="Azure.AI.OpenAI" Version="2.1.0"/>
        <PackageVersion Include="Anthropic" Version="13.14.0"/>
        <PackageVersion Include="Shiny.Blazor.Controls" Version="3.0.0"/>
        <PackageVersion Include="XenoAtom.Terminal.UI" Version="3.12.0"/>
        <PackageVersion Include="XenoAtom.Terminal.UI.Extensions.Screenshot" Version="3.12.0"/>
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="$(MicrosoftExtensionsVersion)"/>
        <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0"/>
        <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="11.0.0"/>
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="11.0.0"/>
        <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="11.0.0"/>
        <PackageVersion Include="Microsoft.Maui.Controls" Version="11.0.10"/>
    </ItemGroup>
    <ItemGroup>
        <PackageVersion Include="BenchmarkDotNet" Version="0.15.8"/>
        <PackageVersion Include="Bogus" Version="35.6.5"/>
        <PackageVersion Include="Dapper" Version="2.1.100"/>
        <PackageVersion Include="sqlite-net-pcl" Version="1.11.285"/>
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0"/>
        <PackageVersion Include="xunit.v3" Version="4.0.3"/>
        <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1"/>
        <PackageVersion Include="Testcontainers.MsSql" Version="$(TestcontainersVersion)"/>
        <PackageVersion Include="Testcontainers.MySql" Version="$(TestcontainersVersion)"/>
        <PackageVersion Include="Testcontainers.MariaDb" Version="$(TestcontainersVersion)"/>
        <PackageVersion Include="Testcontainers.PostgreSql" Version="$(TestcontainersVersion)"/>
        <PackageVersion Include="Testcontainers.CosmosDb" Version="$(TestcontainersVersion)"/>
        <PackageVersion Include="Testcontainers.MongoDb" Version="$(TestcontainersVersion)"/>
        <PackageVersion Include="Testcontainers.Oracle" Version="$(TestcontainersVersion)"/>
        <PackageVersion Include="Testcontainers.Azurite" Version="$(TestcontainersVersion)"/>
        <PackageVersion Include="Testcontainers.DynamoDb" Version="$(TestcontainersVersion)"/>
        <PackageVersion Include="Testcontainers.Redis" Version="$(TestcontainersVersion)"/>
        <PackageVersion Include="Testcontainers.RavenDb" Version="$(TestcontainersVersion)"/>
    </ItemGroup>
</Project>