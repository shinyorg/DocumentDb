<Project Sdk="Microsoft.NET.Sdk">
    <!--
      Its own test process on purpose: SqlCipherEngine swaps the process-wide SQLitePCLRaw provider,
      which must not happen underneath the main suite's open e_sqlite3 connections.
    -->
    <PropertyGroup>
        <TargetFramework>$(BaseTargetFramework)</TargetFramework>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
        <PackageReference Include="xunit.v3"/>
        <PackageReference Include="xunit.runner.visualstudio"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Shiny.DocumentDb.Sqlite.SqlCipher\Shiny.DocumentDb.Sqlite.SqlCipher.csproj"/>
    </ItemGroup>
</Project>
