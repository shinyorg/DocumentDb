<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>$(BaseTargetFramework)</TargetFramework>
        <IsPackable>false</IsPackable>
        <NoWarn>$(NoWarn);xUnit1051</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
        <PackageReference Include="xunit.v3"/>
        <PackageReference Include="xunit.runner.visualstudio"/>
        <PackageReference Include="Testcontainers.MsSql"/>
        <PackageReference Include="Testcontainers.MySql"/>
        <PackageReference Include="Testcontainers.PostgreSql"/>
        <PackageReference Include="Testcontainers.CosmosDb"/>
        <PackageReference Include="Testcontainers.MongoDb"/>
        <PackageReference Include="Testcontainers.Oracle"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection"/>
    </ItemGroup>

    <ItemGroup>
        <!-- sqlite-vec native binary for the vector integration tests. Only the OS+arch
             relevant to the current dev box is committed; CI should download per-platform. -->
        <None Include="runtimes\osx-arm64\native\vec0.dylib" Condition="Exists('runtimes\osx-arm64\native\vec0.dylib')">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Link>vec0.dylib</Link>
        </None>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Shiny.DocumentDb\Shiny.DocumentDb.csproj"/>
        <ProjectReference Include="..\..\src\Shiny.DocumentDb.Sqlite\Shiny.DocumentDb.Sqlite.csproj"/>
        <ProjectReference Include="..\..\src\Shiny.DocumentDb.SqlServer\Shiny.DocumentDb.SqlServer.csproj"/>
        <ProjectReference Include="..\..\src\Shiny.DocumentDb.MySql\Shiny.DocumentDb.MySql.csproj"/>
        <ProjectReference Include="..\..\src\Shiny.DocumentDb.PostgreSql\Shiny.DocumentDb.PostgreSql.csproj"/>
        <ProjectReference Include="..\..\src\Shiny.DocumentDb.LiteDb\Shiny.DocumentDb.LiteDb.csproj"/>
        <ProjectReference Include="..\..\src\Shiny.DocumentDb.CosmosDb\Shiny.DocumentDb.CosmosDb.csproj"/>
        <ProjectReference Include="..\..\src\Shiny.DocumentDb.DuckDb\Shiny.DocumentDb.DuckDb.csproj"/>
        <ProjectReference Include="..\..\src\Shiny.DocumentDb.MongoDb\Shiny.DocumentDb.MongoDb.csproj"/>
        <ProjectReference Include="..\..\src\Shiny.DocumentDb.Oracle\Shiny.DocumentDb.Oracle.csproj"/>
        <ProjectReference Include="..\..\src\Shiny.DocumentDb.Diagnostics\Shiny.DocumentDb.Diagnostics.csproj"/>
        <ProjectReference Include="..\..\src\Shiny.DocumentDb.Extensions.DependencyInjection\Shiny.DocumentDb.Extensions.DependencyInjection.csproj"/>
        <ProjectReference Include="..\..\src\Shiny.DocumentDb.Generators\Shiny.DocumentDb.Generators.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
    </ItemGroup>
</Project>
