<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>$(BaseTargetFramework)</TargetFramework>
        <IsPackable>false</IsPackable>
        <NoWarn>$(NoWarn);xUnit1051</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
        <PackageReference Include="xunit.v3"/>
        <PackageReference Include="xunit.runner.visualstudio"/>
        <PackageReference Include="Testcontainers.MsSql"/>
        <PackageReference Include="Testcontainers.MySql"/>
        <PackageReference Include="Testcontainers.MariaDb"/>
        <PackageReference Include="Testcontainers.PostgreSql"/>
        <PackageReference Include="Testcontainers.CosmosDb"/>
        <PackageReference Include="Testcontainers.MongoDb"/>
        <PackageReference Include="Testcontainers.Oracle"/>
        <PackageReference Include="Testcontainers.Azurite"/>
        <PackageReference Include="Testcontainers.DynamoDb"/>
        <PackageReference Include="Testcontainers.Redis"/>
        <PackageReference Include="Testcontainers.RavenDb"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection"/>
    </ItemGroup>

    <ItemGroup>
        <!-- sqlite-vec native binary for the vector integration tests. Only the OS+arch
             relevant to the current dev box is committed; CI should download per-platform. -->
        <None Include="runtimes\osx-arm64\native\vec0.dylib" Condition="Exists('runtimes\osx-arm64\native\vec0.dylib')">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Link>vec0.dylib</Link>
        </None>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Shiny.DocumentDb\Shiny.DocumentDb.csproj"/>
        <ProjectReference Include="..\..\src\Shiny.DocumentDb.Sqlite\Shiny.DocumentDb.Sqlite.csproj"/>
        <ProjectReference Include="..\..\src\Shiny.DocumentDb.SqlServer\Shiny.DocumentDb.SqlServer.csproj"/>
        <ProjectReference Include="..\..\src\Shiny.DocumentDb.MySql\Shiny.DocumentDb.MySql.csproj"/>
        <ProjectReference Include="..\..\src\Shiny.DocumentDb.MariaDb\Shiny.DocumentDb.MariaDb.csproj"/>
        <ProjectReference Include="..\..\src\Shiny.DocumentDb.PostgreSql\Shiny.DocumentDb.PostgreSql.csproj"/>
        <ProjectReference Include="..\..\src\Shiny.DocumentDb.CockroachDb\Shiny.DocumentDb.CockroachDb.csproj"/>
        <ProjectReference Include="..\..\src\Shiny.DocumentDb.LiteDb\Shiny.DocumentDb.LiteDb.csproj"/>
        <ProjectReference Include="..\..\src\Shiny.DocumentDb.CosmosDb\Shiny.DocumentDb.CosmosDb.csproj"/>
        <ProjectReference Include="..\..\src\Shiny.DocumentDb.AzureTable\Shiny.DocumentDb.AzureTable.csproj"/>
        <ProjectReference Include="..\..\src\Shiny.DocumentDb.DynamoDb\Shiny.DocumentDb.DynamoDb.csproj"/>
        <ProjectReference Include="..\..\src\Shiny.DocumentDb.DuckDb\Shiny.DocumentDb.DuckDb.csproj"/>
        <ProjectReference Include="..\..\src\Shiny.DocumentDb.MongoDb\Shiny.DocumentDb.MongoDb.csproj"/>
        <ProjectReference Include="..\..\src\Shiny.DocumentDb.Oracle\Shiny.DocumentDb.Oracle.csproj"/>
        <ProjectReference Include="..\..\src\Shiny.DocumentDb.Redis\Shiny.DocumentDb.Redis.csproj"/>
        <ProjectReference Include="..\..\src\Shiny.DocumentDb.RavenDb\Shiny.DocumentDb.RavenDb.csproj"/>
        <ProjectReference Include="..\..\src\Shiny.DocumentDb.Firestore\Shiny.DocumentDb.Firestore.csproj"/>
        <ProjectReference Include="..\..\src\Shiny.DocumentDb.DocumentDb\Shiny.DocumentDb.DocumentDb.csproj"/>
        <!-- The MEVD connector suites live here rather than in their own project so they can reuse the
             Testcontainers fixtures (pgvector, Atlas Local) and the sqlite-vec binary already wired up above. -->
        <ProjectReference Include="..\..\src\Shiny.DocumentDb.Extensions.VectorData\Shiny.DocumentDb.Extensions.VectorData.csproj"/>
        <ProjectReference Include="..\..\src\Shiny.DocumentDb.Generators\Shiny.DocumentDb.Generators.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
    </ItemGroup>
</Project>
