<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>$(BaseTargetFramework)</TargetFramework>
        <IsPackable>false</IsPackable>
        <EnableAotAnalyzer>false</EnableAotAnalyzer>
        <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
        <PackageReference Include="xunit.v3"/>
        <PackageReference Include="xunit.runner.visualstudio"/>
        <!-- Aspire.Hosting 13.4.6 needs Microsoft.Extensions.Hosting >= 10.0.8. Override here (non-shipped test)
             instead of raising the central 10.0.7 library floor. -->
        <PackageReference Include="Microsoft.Extensions.Hosting" VersionOverride="10.0.8"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Shiny.DocumentDb.Aspire.Hosting\Shiny.DocumentDb.Aspire.Hosting.csproj"/>
        <ProjectReference Include="..\..\src\Shiny.DocumentDb.Aspire.Client\Shiny.DocumentDb.Aspire.Client.csproj"/>
        <ProjectReference Include="..\..\src\Shiny.DocumentDb.Aspire.Orleans\Shiny.DocumentDb.Aspire.Orleans.csproj"/>
        <!-- Wire the source generator so a real generated DocumentContext can be tested here. -->
        <ProjectReference Include="..\..\src\Shiny.DocumentDb.Generators\Shiny.DocumentDb.Generators.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
    </ItemGroup>
</Project>
